{
  "name": "jk-optimize-bot",
  "version": "0.1.0",
  "description": "JK Optimize Bot — serviço independente de administração, suporte e vendas para Discord",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.5.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && node dist/src/index.js",
    "doctor": "npm run build && node dist/src/scripts/doctor.js",
    "commands:deploy": "npm run build && node dist/src/scripts/deploy-commands.js",
    "invite": "npm run build && node dist/src/scripts/invite.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9"
  }
}
