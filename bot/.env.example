# Copie para .env e preencha. NUNCA versione o .env nem publique o token.
# Token do bot: Discord Developer Portal -> sua aplicação -> Bot -> Reset Token.
DISCORD_TOKEN=
# Application ID (General Information -> Application ID).
DISCORD_CLIENT_ID=
# Opcional: ID de um servidor de testes. Com ele, os comandos são registrados só ali (instantâneo).
# Vazio = registro global (pode levar até 1 hora para aparecer).
DISCORD_DEV_GUILD_ID=
# IDs de usuário Discord (separados por vírgula) com acesso administrativo ao bot, além de quem tem "Gerenciar Servidor".
BOT_OWNER_IDS=
# Caminho do banco SQLite.
DATABASE_PATH=./data/bot.sqlite
# debug | info | warn | error
LOG_LEVEL=info
